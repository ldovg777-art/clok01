  {
    "id": "event_handler_function",
    "type": "function",
    "z": "f3c6e6f6b9a4d123",
    "name": "Обработка событий UI Control",
    "func": "// Обработка событий от ui_ui_control\nvar eventType = msg.payload; // connect, lost, change, group\nvar socketId = msg.socketid;\nvar socketIp = msg.socketip;\n\nswitch(eventType) {\n    case 'connect':\n        // Клиент подключился\n        node.status({ fill: 'green', shape: 'dot', text: 'Клиент подключен: ' + socketIp });\n        node.log('Новый клиент подключен. Socket ID: ' + socketId + ', IP: ' + socketIp);\n        \n        // Можно отправить начальные данные новому клиенту\n        msg.topic = 'client_connected';\n        msg.payload = {\n            socketId: socketId,\n            socketIp: socketIp,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'lost':\n        // Клиент отключился\n        node.status({ fill: 'red', shape: 'ring', text: 'Клиент отключен: ' + socketIp });\n        node.log('Клиент отключен. Socket ID: ' + socketId + ', IP: ' + socketIp);\n        \n        msg.topic = 'client_disconnected';\n        msg.payload = {\n            socketId: socketId,\n            socketIp: socketIp,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'change':\n        // Вкладка изменена\n        var tabNumber = msg.tab;\n        var tabName = msg.name;\n        node.status({ fill: 'blue', shape: 'dot', text: 'Вкладка: ' + tabName });\n        node.log('Вкладка изменена на: ' + tabName + ' (номер: ' + tabNumber + ')');\n        \n        msg.topic = 'tab_changed';\n        msg.payload = {\n            tabNumber: tabNumber,\n            tabName: tabName,\n            socketId: socketId,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'group':\n        // Группа изменена (развернута/свернута)\n        var groupName = msg.group;\n        var isOpen = msg.open;\n        node.status({ fill: 'yellow', shape: 'dot', text: 'Группа: ' + groupName + ' (' + (isOpen ? 'открыта' : 'закрыта') + ')' });\n        node.log('Группа ' + groupName + ' ' + (isOpen ? 'открыта' : 'закрыта'));\n        \n        msg.topic = 'group_changed';\n        msg.payload = {\n            groupName: groupName,\n            isOpen: isOpen,\n            socketId: socketId,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    default:\n        node.warn('Неизвестный тип события: ' + eventType);\n        return null;\n}\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 360,
    "wires": [
