  {
    "id": "ui_control_template",
    "type": "ui_template",
    "z": "f3c6e6f6b9a4d123",
    "group": "control_group_example",
    "name": "UI Control Кнопки",
    "order": 2,
    "width": 12,
    "height": 6,
    "format": "<div style=\"padding: 16px;\">\n  <h3>Примеры управления Dashboard через UI Control</h3>\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 16px;\">\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {tab: 'Main'}})\">Main</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {tab: 'Версии'}})\">Версии</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {tab: 'Календарь'}})\">Календарь</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: '+1'})\">Следующая</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: '-1'})\">Предыдущая</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: ''})\">Обновить</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {group: {hide: ['Main_System']}}})\">Скрыть System</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {group: {show: ['Main_System']}}})\">Показать System</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {group: {focus: true, show: ['Main_Clock']}}})\">Фокус Clock</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {tabs: {disable: ['Версии']}}})\">Отключить Версии</button>\n    <button class=\"ui-control-btn\" ng-click=\"send({payload: {tabs: {enable: ['Версии']}}})\">Включить Версии</button>\n  </div>\n</div>\n<style>\n  .ui-control-btn {\n    padding: 10px 16px;\n    background: #2196F3;\n    color: white;\n    border: none;\n    border-radius: 4px;\n    cursor: pointer;\n    font-size: 14px;\n    transition: background 0.2s;\n  }\n  .ui-control-btn:hover {\n    background: #1976D2;\n  }\n  .ui-control-btn:active {\n    background: #0D47A1;\n  }\n</style>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 700,
    "y": 480,
    "wires": [
      [
        "bbe5981b03bcbb10"
      ]
    ]
  },
  {
    "id": "example_info",
    "type": "ui_text",
    "z": "f3c6e6f6b9a4d123",
    "group": "control_group_example",
    "order": 3,
    "width": 12,
    "height": 3,
    "name": "Информация о UI Control",
    "label": "Описание",
    "format": "<div style=\"padding: 12px; background: #f5f5f5; border-radius: 4px;\">\n  <h4>UI Control Node - Примеры использования</h4>\n  <p><strong>Функции:</strong></p>\n  <ul>\n    <li>Переключение вкладок: <code>{\"tab\": \"имя_вкладки\"}</code> или <code>\"+1\"</code> / <code>\"-1\"</code></li>\n    <li>Обновление страницы: <code>\"\"</code> (пустая строка)</li>\n    <li>Управление группами: <code>{\"group\": {\"hide\": [\"группа\"], \"show\": [\"группа\"], \"focus\": true}}</code></li>\n    <li>Управление вкладками: <code>{\"tabs\": {\"hide\": \"вкладка\", \"disable\": [\"вкладка\"]}}</code></li>\n  </ul>\n  <p><strong>События:</strong> connect, lost, change, group</p>\n</div>",
    "layout": "row-spread",
    "x": 680,
    "y": 620,
    "wires": []
  }
]
