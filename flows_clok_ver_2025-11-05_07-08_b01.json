    "label": "Последнее событие",
    "format": "<div style=\"padding: 8px;\">\n  <strong>Тип:</strong> {{msg.topic}}<br>\n  <strong>Время:</strong> {{msg.payload.timestamp || msg.timestamp}}<br>\n  <strong>Socket ID:</strong> {{msg.payload.socketId || msg.socketid}}<br>\n  <strong>IP:</strong> {{msg.payload.socketIp || msg.socketip}}<br>\n  <strong>Детали:</strong> {{JSON.stringify(msg.payload)}}\n</div>",
    "layout": "row-spread",
