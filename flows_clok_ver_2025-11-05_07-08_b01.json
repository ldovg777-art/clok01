    "wires": []
  },
  {
    "id": "auto_switch_tabs",
    "type": "function",
    "z": "f3c6e6f6b9a4d123",
    "name": "Автопереключение вкладок",
    "func": "// Автоматическое переключение между вкладками каждые 10 секунд\nvar tabs = ['Main', 'Версии', 'Календарь'];\nvar currentIndex = flow.get('currentTabIndex') || 0;\n\n// Переключаем на следующую вкладку\ncurrentIndex = (currentIndex + 1) % tabs.length;\nflow.set('currentTabIndex', currentIndex);\n\nmsg.payload = {\n    tab: tabs[currentIndex]\n};\n\nnode.status({ fill: 'green', shape: 'dot', text: 'Переключено на: ' + tabs[currentIndex] });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 220,
    "y": 920,
    "wires": [
      [
        "bbe5981b03bcbb10"
      ]
    ]
  },
