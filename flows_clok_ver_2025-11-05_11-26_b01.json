  {
    "id": "a725d0f4e0cda361",
    "type": "ui_template",
    "z": "f3c6e6f6b9a4d123",
    "group": "fa71b6d8bf8a3b62",
    "name": "Analog Clock",
    "order": 1,
    "width": 6,
    "height": 6,
    "format": "<div class=\"analog-clock-wrapper\">\n    <svg id=\"analog-clock-{{$id}}\" viewBox=\"0 0 200 200\" class=\"analog-clock\">\n        <circle class=\"clock-face\" cx=\"100\" cy=\"100\" r=\"95\"></circle>\n        <g class=\"minute-marks\"></g>\n        <g class=\"hour-marks\"></g>\n        <g class=\"hour-numbers\"></g>\n        <g class=\"subdial minute-subdial\">\n            <circle class=\"subdial-face\" cx=\"60\" cy=\"140\" r=\"28\"></circle>\n            <g class=\"subdial-marks minute-sub-marks\"></g>\n            <line class=\"minute-sub-hand\" x1=\"60\" y1=\"140\" x2=\"60\" y2=\"118\"></line>\n            <circle class=\"subdial-cap\" cx=\"60\" cy=\"140\" r=\"3\"></circle>\n            <text class=\"subdial-label\" x=\"60\" y=\"172\">Минуты</text>\n        </g>\n        <g class=\"subdial second-subdial\">\n            <circle class=\"subdial-face\" cx=\"140\" cy=\"140\" r=\"28\"></circle>\n            <g class=\"subdial-marks second-sub-marks\"></g>\n            <line class=\"second-sub-hand\" x1=\"140\" y1=\"140\" x2=\"140\" y2=\"118\"></line>\n            <circle class=\"subdial-cap\" cx=\"140\" cy=\"140\" r=\"3\"></circle>\n            <text class=\"subdial-label\" x=\"140\" y=\"172\">Секунды</text>\n        </g>\n        <line class=\"hour-hand\" x1=\"100\" y1=\"100\" x2=\"100\" y2=\"70\"></line>\n        <line class=\"minute-hand\" x1=\"100\" y1=\"100\" x2=\"100\" y2=\"40\"></line>\n        <line class=\"second-hand\" x1=\"100\" y1=\"100\" x2=\"100\" y2=\"30\"></line>\n        <circle class=\"center-cap\" cx=\"100\" cy=\"100\" r=\"4\"></circle>\n    </svg>\n</div>\n<script>\n/**\n * Аналоговые часы с оптимизированным рендерингом\n * Использует кэширование статических элементов и оптимизированные обновления\n */\n(function(scope){\n    'use strict';\n    \n    var clockId = \"analog-clock-\" + scope.$id;\n    var lastUpdateTime = null;\n    var updateThrottle = 100; // Минимальный интервал обновления в мс\n    \n    /**\n     * Константы для рендеринга циферблата\n     */\n    var CLOCK_CENTER = { x: 100, y: 100 };\n    var SUBDIAL_MINUTE_CENTER = { x: 60, y: 140 };\n    var SUBDIAL_SECOND_CENTER = { x: 140, y: 140 };\n    var SVG_NS = \"http://www.w3.org/2000/svg\";\n    \n    /**\n     * Рендеринг статических элементов циферблата (выполняется один раз)\n     * @param {Element} base - SVG элемент циферблата\n     */\n    function renderStatic(base){\n        if(!base || base.dataset.rendered === 'true'){\n            return;\n        }\n        \n        try {\n            var hourMarks = base.querySelector('.hour-marks');\n            var minuteMarks = base.querySelector('.minute-marks');\n            var hourNumbers = base.querySelector('.hour-numbers');\n            var minuteSubMarks = base.querySelector('.minute-sub-marks');\n            var secondSubMarks = base.querySelector('.second-sub-marks');\n\n            // Рендеринг часовых меток (12 меток)\n            if(hourMarks){\n                for(var i = 0; i < 12; i++){\n                    var angle = (i / 12) * Math.PI * 2;\n                    var sin = Math.sin(angle);\n                    var cos = Math.cos(angle);\n                    var x1 = CLOCK_CENTER.x + sin * 78;\n                    var y1 = CLOCK_CENTER.y - cos * 78;\n                    var x2 = CLOCK_CENTER.x + sin * 90;\n                    var y2 = CLOCK_CENTER.y - cos * 90;\n                    \n                    var line = document.createElementNS(SVG_NS, \"line\");\n                    line.setAttribute(\"x1\", x1.toFixed(3));\n                    line.setAttribute(\"y1\", y1.toFixed(3));\n                    line.setAttribute(\"x2\", x2.toFixed(3));\n                    line.setAttribute(\"y2\", y2.toFixed(3));\n                    hourMarks.appendChild(line);\n                }\n            }\n\n            // Рендеринг минутных меток (60 меток)\n            if(minuteMarks){\n                for(var j = 0; j < 60; j++){\n                    var angleM = (j / 60) * Math.PI * 2;\n                    var inner = (j % 5 === 0) ? 88 : 92;\n                    var sinM = Math.sin(angleM);\n                    var cosM = Math.cos(angleM);\n                    var x1m = CLOCK_CENTER.x + sinM * inner;\n                    var y1m = CLOCK_CENTER.y - cosM * inner;\n                    var x2m = CLOCK_CENTER.x + sinM * 94;\n                    var y2m = CLOCK_CENTER.y - cosM * 94;\n                    \n                    var lineM = document.createElementNS(SVG_NS, \"line\");\n                    lineM.setAttribute(\"x1\", x1m.toFixed(3));\n                    lineM.setAttribute(\"y1\", y1m.toFixed(3));\n                    lineM.setAttribute(\"x2\", x2m.toFixed(3));\n                    lineM.setAttribute(\"y2\", y2m.toFixed(3));\n                    minuteMarks.appendChild(lineM);\n                }\n            }\n\n            // Рендеринг цифр на циферблате (1-12)\n            if(hourNumbers){\n                for(var n = 1; n <= 12; n++){\n                    var angleN = (n / 12) * Math.PI * 2;\n                    var xN = CLOCK_CENTER.x + Math.sin(angleN) * 70;\n                    var yN = CLOCK_CENTER.y - Math.cos(angleN) * 70;\n                    \n                    var text = document.createElementNS(SVG_NS, \"text\");\n                    text.setAttribute(\"x\", xN.toFixed(3));\n                    text.setAttribute(\"y\", yN.toFixed(3));\n                    text.setAttribute(\"text-anchor\", \"middle\");\n                    text.setAttribute(\"alignment-baseline\", \"middle\");\n                    text.textContent = n;\n                    hourNumbers.appendChild(text);\n                }\n            }\n\n            /**\n             * Создание меток для субциферблатов\n             * @param {Element} group - SVG группа для меток\n             * @param {number} cx - X координата центра субциферблата\n             */\n            function createSubMarks(group, cx){\n                if(!group){\n                    return;\n                }\n                var cy = SUBDIAL_MINUTE_CENTER.y;\n                for(var k = 0; k < 12; k++){\n                    var angleS = (k / 12) * Math.PI * 2;\n                    var sinS = Math.sin(angleS);\n                    var cosS = Math.cos(angleS);\n                    var x1s = cx + sinS * 18;\n                    var y1s = cy - cosS * 18;\n                    var x2s = cx + sinS * 25;\n                    var y2s = cy - cosS * 25;\n                    \n                    var lineS = document.createElementNS(SVG_NS, \"line\");\n                    lineS.setAttribute(\"x1\", x1s.toFixed(3));\n                    lineS.setAttribute(\"y1\", y1s.toFixed(3));\n                    lineS.setAttribute(\"x2\", x2s.toFixed(3));\n                    lineS.setAttribute(\"y2\", y2s.toFixed(3));\n                    group.appendChild(lineS);\n                }\n            }\n\n            createSubMarks(minuteSubMarks, SUBDIAL_MINUTE_CENTER.x);\n            createSubMarks(secondSubMarks, SUBDIAL_SECOND_CENTER.x);\n\n            base.dataset.rendered = \"true\";\n        } catch(error) {\n            console.error('Ошибка рендеринга статических элементов часов:', error);\n        }\n    }\n\n    /**\n     * Применение времени к стрелкам часов\n     * Оптимизировано для минимизации DOM операций\n     * @param {Object} msg - Сообщение с данными времени\n     */\n    function applyTime(msg){\n        if(!msg || !msg.time){\n            return;\n        }\n        \n        // Throttle для предотвращения избыточных обновлений\n        var now = Date.now();\n        if(lastUpdateTime && (now - lastUpdateTime) < updateThrottle){\n            return;\n        }\n        lastUpdateTime = now;\n        \n        try {\n            var base = document.getElementById(clockId);\n            if(!base){\n                return;\n            }\n            \n            renderStatic(base);\n            \n            // Валидация и нормализация времени\n            var time = msg.time;\n            var hours = Math.max(0, Math.min(23, Number(time.hours) || 0));\n            var minutes = Math.max(0, Math.min(59, Number(time.minutes) || 0));\n            var seconds = Math.max(0, Math.min(59, Number(time.seconds) || 0));\n\n            // Вычисление углов для стрелок\n            var hourAngle = ((hours % 12) + minutes / 60) * 30;\n            var minuteAngle = (minutes + seconds / 60) * 6;\n            var secondAngle = seconds * 6;\n\n            // Кэширование элементов для уменьшения запросов к DOM\n            var hourHand = base.querySelector('.hour-hand');\n            var minuteHand = base.querySelector('.minute-hand');\n            var secondHand = base.querySelector('.second-hand');\n            var minuteSubHand = base.querySelector('.minute-sub-hand');\n            var secondSubHand = base.querySelector('.second-sub-hand');\n\n            // Обновление позиций стрелок\n            if(hourHand){\n                hourHand.setAttribute(\"transform\", \"rotate(\" + hourAngle.toFixed(2) + \" \" + CLOCK_CENTER.x + \" \" + CLOCK_CENTER.y + \")\");\n            }\n            if(minuteHand){\n                minuteHand.setAttribute(\"transform\", \"rotate(\" + minuteAngle.toFixed(2) + \" \" + CLOCK_CENTER.x + \" \" + CLOCK_CENTER.y + \")\");\n            }\n            if(secondHand){\n                secondHand.setAttribute(\"transform\", \"rotate(\" + secondAngle.toFixed(2) + \" \" + CLOCK_CENTER.x + \" \" + CLOCK_CENTER.y + \")\");\n            }\n            if(minuteSubHand){\n                minuteSubHand.setAttribute(\"transform\", \"rotate(\" + minuteAngle.toFixed(2) + \" \" + SUBDIAL_MINUTE_CENTER.x + \" \" + SUBDIAL_MINUTE_CENTER.y + \")\");\n            }\n            if(secondSubHand){\n                secondSubHand.setAttribute(\"transform\", \"rotate(\" + secondAngle.toFixed(2) + \" \" + SUBDIAL_SECOND_CENTER.x + \" \" + SUBDIAL_SECOND_CENTER.y + \")\");\n            }\n        } catch(error) {\n            console.error('Ошибка обновления времени часов:', error);\n        }\n    }\n\n    // Наблюдение за изменениями сообщений\n    scope.$watch('msg', function(msg){\n        if(!msg || !msg.time){\n            return;\n        }\n        scope.$evalAsync(function(){\n            applyTime(msg);\n        });\n    });\n})(scope);\n</script>\n<style>\n    .analog-clock-wrapper{\n        display:flex;\n        justify-content:center;\n        align-items:center;\n        width:100%;\n        height:100%;\n        padding:10px;\n        box-sizing:border-box;\n    }\n    .analog-clock{\n        max-width:100%;\n        max-height:100%;\n    }\n    .clock-face{\n        fill:#1b1b1b;\n        stroke:#f5f5f5;\n        stroke-width:4;\n    }\n    .hour-marks line{\n        stroke:#f5f5f5;\n        stroke-width:3.5;\n        stroke-linecap:round;\n    }\n    .minute-marks line{\n        stroke:#888;\n        stroke-width:1.5;\n        stroke-linecap:round;\n    }\n    .hour-numbers text{\n        fill:#ffffff;\n        font-size:14px;\n        font-weight:bold;\n    }\n    .hour-hand{\n        stroke:#ffffff;\n        stroke-width:6;\n        stroke-linecap:round;\n    }\n    .minute-hand{\n        stroke:#ffffff;\n        stroke-width:4;\n        stroke-linecap:round;\n    }\n    .second-hand{\n        stroke:#ff5722;\n        stroke-width:2;\n        stroke-linecap:round;\n    }\n    .center-cap{\n        fill:#ff5722;\n    }\n    .subdial-face{\n        fill:#101010;\n        stroke:#b0bec5;\n        stroke-width:2;\n    }\n    .subdial-marks line{\n        stroke:#b0bec5;\n        stroke-width:1.2;\n        stroke-linecap:round;\n    }\n    .minute-sub-hand{\n        stroke:#4caf50;\n        stroke-width:3;\n        stroke-linecap:round;\n    }\n    .second-sub-hand{\n        stroke:#ff9800;\n        stroke-width:2.5;\n        stroke-linecap:round;\n    }\n    .subdial-cap{\n        fill:#ff5722;\n    }\n    .subdial-label{\n        fill:#cfd8dc;\n        font-size:10px;\n        text-anchor:middle;\n        dominant-baseline:hanging;\n    }\n</style>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 440,
    "y": 120,
    "wires": [],
    "info": "Аналоговые часы с SVG рендерингом. Включает основной циферблат и два субциферблата для минут и секунд. Оптимизирован для производительности."
  },
  {
    "id": "a9b8c7d6e5f4a3b2",
    "type": "function",
    "z": "f3c6e6f6b9a4d123",
    "name": "Утилиты: Валидация времени",
    "func": "/**\n * Утилита для валидации и нормализации данных времени\n * Проверяет корректность значений и возвращает нормализованный объект времени\n */\n\nif (!msg || typeof msg !== 'object') {\n    node.status({ fill: 'red', shape: 'ring', text: 'неверный формат сообщения' });\n    node.warn('Утилиты: Валидация времени: получено некорректное сообщение');\n    return null;\n}\n\n// Валидация входных данных\nvar inputTime = msg.time || {};\nvar hours = Number(inputTime.hours);\nvar minutes = Number(inputTime.minutes);\nvar seconds = Number(inputTime.seconds);\n\n// Проверка на NaN и нормализация значений\nif (isNaN(hours)) hours = 0;\nif (isNaN(minutes)) minutes = 0;\nif (isNaN(seconds)) seconds = 0;\n\n// Ограничение значений допустимыми диапазонами\nhours = Math.max(0, Math.min(23, Math.floor(hours)));\nminutes = Math.max(0, Math.min(59, Math.floor(minutes)));\nseconds = Math.max(0, Math.min(59, Math.floor(seconds)));\n\n// Формирование нормализованного объекта времени\nmsg.time = {\n    hours: hours,\n    minutes: minutes,\n    seconds: seconds\n};\n\nnode.status({ fill: 'green', shape: 'dot', text: hours + ':' + minutes + ':' + seconds });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 60,
    "wires": [],
    "info": "Утилита для валидации и нормализации данных времени. Проверяет корректность значений часов, минут и секунд."
  },
  {
    "id": "f8f0c1aeb54b9a66",
    "type": "function",
    "z": "f3c6e6f6b9a4d123",
    "name": "Формат времени",
    "func": "/**\n * Форматирование текущего времени сервера\n * Возвращает время в различных форматах для использования в UI\n * Включает валидацию и обработку ошибок\n */\n\ntry {\n    var now = new Date();\n    \n    // Валидация корректности даты\n    if (isNaN(now.getTime())) {\n        node.status({ fill: 'red', shape: 'ring', text: 'некорректное время' });\n        node.warn('Формат времени: получено некорректное значение времени');\n        return null;\n    }\n\n    // Форматирование дня недели на русском языке\n    var weekday = now.toLocaleDateString('ru-RU', { weekday: 'long' });\n    if (weekday) {\n        weekday = weekday.charAt(0).toUpperCase() + weekday.slice(1);\n    } else {\n        weekday = '';\n    }\n\n    // Форматирование времени в формате ЧЧ:ММ:СС\n    var timeString = now.toLocaleTimeString('ru-RU', {\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: false\n    });\n\n    // Форматирование даты на русском языке\n    var dateString = now.toLocaleDateString('ru-RU', {\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric'\n    });\n\n    // ISO строки для совместимости\n    var isoString = now.toISOString();\n    var dateISO = isoString.slice(0, 10);\n\n    // Формирование сообщения с данными времени\n    msg = {\n        payload: timeString,\n        date: dateString,\n        weekday: weekday,\n        datetime: (weekday ? weekday + ', ' : '') + dateString,\n        iso: isoString,\n        dateISO: dateISO,\n        timestamp: now.getTime(),\n        time: {\n            hours: now.getHours(),\n            minutes: now.getMinutes(),\n            seconds: now.getSeconds()\n        }\n    };\n\n    node.status({ fill: 'green', shape: 'dot', text: timeString });\n    return msg;\n    \n} catch (error) {\n    node.status({ fill: 'red', shape: 'ring', text: 'ошибка форматирования' });\n    node.error('Формат времени: ошибка при форматировании времени - ' + error.message, error);\n    return null;\n}",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
