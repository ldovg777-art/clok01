  },
  {
    "id": "d35f6a0e7d8e2b3a",
    "type": "ui_template",
    "z": "f3c6e6f6b9a4d123",
    "name": "Календарь",
    "group": "ef7d4c1a2b963058",
    "order": 1,
    "width": 24,
    "height": 12,
    "format": "<md-card class=\"calendar-card\">\n    <div class=\"calendar-content\">\n        <div class=\"calendar-toolbar\">\n            <button class=\"calendar-nav\" ng-click=\"changeMonth(-1)\" aria-label=\"Предыдущий месяц\">&#8249;</button>\n            <div class=\"calendar-title\">{{monthTitle}}</div>\n            <button class=\"calendar-nav\" ng-click=\"changeMonth(1)\" aria-label=\"Следующий месяц\">&#8250;</button>\n        </div>\n        <div class=\"calendar-weekdays\">\n            <div class=\"calendar-weekday\" ng-repeat=\"weekday in weekdayLabels track by $index\">{{weekday}}</div>\n        </div>\n        <div class=\"calendar-grid\">\n            <div class=\"calendar-day\"\n                 ng-repeat=\"day in days track by day.iso\"\n                 ng-class=\"{'other-month': day.otherMonth, 'today': day.isToday, 'selected': day.isSelected}\"\n                 ng-click=\"selectDay(day)\">\n                <span class=\"calendar-day-number\">{{day.label}}</span>\n            </div>\n        </div>\n    </div>\n</md-card>\n<script>\n/**\n * Календарь с оптимизированным рендерингом\n * Включает валидацию дат и оптимизацию обновлений\n */\n(function(scope){\n    'use strict';\n    \n    var today = new Date();\n    var monthNames = ['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];\n    var weekdayLabels = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];\n\n    scope.weekdayLabels = weekdayLabels;\n    scope.days = [];\n    scope.calendarDate = scope.calendarDate || null;\n    scope.viewDate = scope.viewDate || null;\n    \n    var lastBuildTime = null;\n    var buildThrottle = 50; // Минимальный интервал перестроения календаря в мс\n\n    /**\n     * Преобразование Date в ISO строку (YYYY-MM-DD)\n     * @param {Date} date - Дата для преобразования\n     * @returns {string|null} ISO строка или null при ошибке\n     */\n    function toISO(date){\n        if(!(date instanceof Date) || isNaN(date.getTime())){\n            return null;\n        }\n        try {\n            var local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);\n            return local.toISOString().slice(0, 10);\n        } catch(error) {\n            console.error('Ошибка преобразования даты в ISO:', error);\n            return null;\n        }\n    }\n\n    var todayIso = toISO(today);\n\n    /**\n     * Преобразование ISO строки в Date объект\n     * @param {string} iso - ISO строка формата YYYY-MM-DD\n     * @returns {Date|null} Date объект или null при ошибке\n     */\n    function fromISO(iso){\n        if(!iso || typeof iso !== 'string' || iso.length < 10){\n            return null;\n        }\n        try {\n            var parts = iso.slice(0, 10).split('-');\n            if(parts.length !== 3){\n                return null;\n            }\n            var year = parseInt(parts[0], 10);\n            var month = parseInt(parts[1], 10) - 1;\n            var day = parseInt(parts[2], 10);\n            \n            // Валидация значений\n            if(isNaN(year) || isNaN(month) || isNaN(day)){\n                return null;\n            }\n            if(month < 0 || month > 11 || day < 1 || day > 31){\n                return null;\n            }\n            \n            var result = new Date(year, month, day);\n            \n            // Проверка корректности результата\n            if(result.getFullYear() !== year || result.getMonth() !== month || result.getDate() !== day){\n                return null;\n            }\n            \n            return result;\n        } catch(error) {\n            console.error('Ошибка преобразования ISO в дату:', error);\n            return null;\n        }\n    }\n\n    /**\n     * Нормализация различных форматов даты в ISO строку\n     * @param {*} value - Значение для нормализации (Date, number, string)\n     * @returns {string|null} ISO строка или null\n     */\n    function normalize(value){\n        if(value === null || value === undefined){\n            return null;\n        }\n        \n        try {\n            if(typeof value === 'number'){\n                return toISO(new Date(value));\n            }\n            if(value instanceof Date){\n                return toISO(value);\n            }\n            if(typeof value === 'string' && value.length >= 10){\n                var parsed = fromISO(value);\n                return parsed ? toISO(parsed) : null;\n            }\n        } catch(error) {\n            console.error('Ошибка нормализации даты:', error);\n        }\n        \n        return null;\n    }\n\n    /**\n     * Построение календарной сетки для отображаемого месяца\n     * Оптимизировано для предотвращения избыточных перестроений\n     */\n    function buildCalendar(){\n        // Throttle для предотвращения избыточных перестроений\n        var now = Date.now();\n        if(lastBuildTime && (now - lastBuildTime) < buildThrottle){\n            return;\n        }\n        lastBuildTime = now;\n        \n        try {\n            var view = scope.viewDate ? new Date(scope.viewDate.getFullYear(), scope.viewDate.getMonth(), 1) : new Date(today.getFullYear(), today.getMonth(), 1);\n            scope.viewDate = view;\n            var selectedIso = scope.calendarDate || null;\n            \n            // Вычисление первого дня недели для отображаемого месяца\n            var start = new Date(view.getFullYear(), view.getMonth(), 1);\n            var startWeekday = (start.getDay() + 6) % 7; // Понедельник = 0\n            \n            // Начало календарной сетки (понедельник первой недели)\n            var current = new Date(start);\n            current.setDate(current.getDate() - startWeekday);\n            \n            // Построение массива дней (6 недель * 7 дней = 42 дня)\n            var days = [];\n            for(var i = 0; i < 42; i++){\n                var currentDate = new Date(current);\n                var iso = toISO(currentDate);\n                \n                if(!iso) {\n                    // Пропуск некорректных дат\n                    current.setDate(current.getDate() + 1);\n                    continue;\n                }\n                \n                days.push({\n                    iso: iso,\n                    label: currentDate.getDate(),\n                    otherMonth: currentDate.getMonth() !== view.getMonth(),\n                    isToday: todayIso && iso === todayIso,\n                    isSelected: selectedIso && iso === selectedIso\n                });\n                \n                current.setDate(current.getDate() + 1);\n            }\n            \n            scope.days = days;\n            scope.monthTitle = monthNames[view.getMonth()] + ' ' + view.getFullYear();\n        } catch(error) {\n            console.error('Ошибка построения календаря:', error);\n        }\n    }\n\n    /**\n     * Изменение отображаемого месяца\n     * @param {number} step - Шаг изменения месяца (-1 для предыдущего, 1 для следующего)\n     */\n    scope.changeMonth = function(step){\n        if(typeof step !== 'number' || isNaN(step)){\n            return;\n        }\n        \n        try {\n            var base = scope.viewDate ? new Date(scope.viewDate) : new Date(today.getFullYear(), today.getMonth(), 1);\n            scope.viewDate = new Date(base.getFullYear(), base.getMonth() + step, 1);\n            scope.$evalAsync(buildCalendar);\n        } catch(error) {\n            console.error('Ошибка изменения месяца:', error);\n        }\n    };\n\n    /**\n     * Выбор даты в календаре\n     * @param {Object} day - Объект с данными выбранного дня\n     */\n    scope.selectDay = function(day){\n        if(!day || !day.iso){\n            return;\n        }\n        \n        try {\n            scope.calendarDate = day.iso;\n            var parsed = fromISO(day.iso);\n            if(parsed){\n                scope.viewDate = new Date(parsed.getFullYear(), parsed.getMonth(), 1);\n            }\n            scope.send({ payload: day.iso });\n            scope.$evalAsync(buildCalendar);\n        } catch(error) {\n            console.error('Ошибка выбора даты:', error);\n        }\n    };\n\n    /**\n     * Наблюдение за изменениями сообщений для синхронизации календаря\n     */\n    scope.$watch('msg', function(msg){\n        if(!msg){\n            return;\n        }\n        \n        try {\n            var incoming = normalize(msg.dateISO || msg.iso || msg.payload || msg.timestamp);\n            if(incoming && incoming !== scope.calendarDate){\n                scope.calendarDate = incoming;\n                var parsed = fromISO(incoming);\n                if(parsed){\n                    scope.viewDate = new Date(parsed.getFullYear(), parsed.getMonth(), 1);\n                }\n                scope.$evalAsync(buildCalendar);\n            }\n        } catch(error) {\n            console.error('Ошибка обработки сообщения календаря:', error);\n        }\n    });\n\n    /**\n     * Инициализация календаря при загрузке\n     */\n    (function init(){\n        try {\n            var initial = normalize(scope.msg && (scope.msg.dateISO || scope.msg.iso || scope.msg.payload || scope.msg.timestamp));\n            if(!initial){\n                initial = todayIso;\n            }\n            scope.calendarDate = initial;\n            var parsed = fromISO(initial);\n            scope.viewDate = parsed ? new Date(parsed.getFullYear(), parsed.getMonth(), 1) : new Date(today.getFullYear(), today.getMonth(), 1);\n            buildCalendar();\n        } catch(error) {\n            console.error('Ошибка инициализации календаря:', error);\n        }\n    })();\n})(scope);\n</script>\n<style>\n    .calendar-card {\n        width: 100%;\n        height: 100%;\n        box-sizing: border-box;\n        padding: 16px 20px 24px;\n        background-color: #1a1a1a;\n        color: #eceff1;\n        display: flex;\n        flex-direction: column;\n    }\n    .calendar-content {\n        display: flex;\n        flex-direction: column;\n        gap: 16px;\n        flex: 1 1 auto;\n    }\n    .calendar-toolbar {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 16px;\n    }\n    .calendar-title {\n        font-size: 24px;\n        font-weight: 600;\n        letter-spacing: 0.4px;\n        text-transform: capitalize;\n    }\n    .calendar-nav {\n        background: rgba(96, 125, 139, 0.25);\n        border: 1px solid rgba(96, 125, 139, 0.6);\n        color: #eceff1;\n        border-radius: 50%;\n        width: 44px;\n        height: 44px;\n        font-size: 24px;\n        line-height: 1;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        cursor: pointer;\n        transition: background 0.2s ease, border-color 0.2s ease;\n    }\n    .calendar-nav:hover {\n        background: rgba(66, 165, 245, 0.35);\n        border-color: rgba(66, 165, 245, 0.75);\n    }\n    .calendar-weekdays {\n        display: grid;\n        grid-template-columns: repeat(7, minmax(0, 1fr));\n        gap: 8px;\n        text-transform: uppercase;\n        font-size: 14px;\n        color: #90a4ae;\n    }\n    .calendar-weekday {\n        text-align: center;\n        padding: 8px 0;\n        letter-spacing: 0.5px;\n    }\n    .calendar-grid {\n        display: grid;\n        grid-template-columns: repeat(7, minmax(0, 1fr));\n        grid-auto-rows: minmax(72px, 1fr);\n        gap: 8px;\n        flex: 1 1 auto;\n    }\n    .calendar-day {\n        border: 1px solid rgba(96, 125, 139, 0.4);\n        border-radius: 8px;\n        display: flex;\n        justify-content: flex-end;\n        align-items: flex-start;\n        padding: 10px;\n        position: relative;\n        cursor: pointer;\n        background: rgba(38, 50, 56, 0.6);\n        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\n    }\n    .calendar-day:hover {\n        border-color: rgba(66, 165, 245, 0.8);\n        box-shadow: 0 0 8px rgba(66, 165, 245, 0.3);\n    }\n    .calendar-day-number {\n        font-size: 18px;\n        font-weight: 600;\n    }\n    .calendar-day.other-month {\n        opacity: 0.4;\n    }\n    .calendar-day.today {\n        border-color: rgba(76, 175, 80, 0.9);\n        box-shadow: 0 0 8px rgba(76, 175, 80, 0.4);\n    }\n    .calendar-day.selected {\n        background: rgba(66, 165, 245, 0.35);\n        border-color: rgba(66, 165, 245, 0.9);\n        box-shadow: 0 0 12px rgba(66, 165, 245, 0.35);\n    }\n</style>",
