  {
    "id": "b8f34474dd1d4619",
    "type": "function",
    "z": "f3c6e6f6b9a4d123",
    "name": "Отправить версию",
    "func": "/**\n * Получение и форматирование данных версии из flow context\n * Включает валидацию и обработку ошибок\n */\n\ntry {\n    var version = flow.get('version');\n    var versionTime = flow.get('versionTime');\n    var history = flow.get('versionHistory');\n    \n    // Валидация наличия версии\n    if (!version) {\n        node.status({ fill: 'yellow', shape: 'ring', text: 'версия не задана' });\n        node.warn('Отправить версию: отсутствует значение flow.version');\n        return null;\n    }\n    \n    // Валидация истории версий\n    if (!Array.isArray(history)) {\n        history = [];\n        node.warn('Отправить версию: история версий не является массивом, используется пустой массив');\n    }\n    \n    // Формирование строки отображения версии\n    var displayVersion = String(version);\n    if (versionTime && String(versionTime).trim()) {\n        displayVersion = displayVersion + ' ' + String(versionTime).trim();\n    }\n    \n    // Формирование сообщения с данными версии\n    msg.version = String(version);\n    msg.versionTime = versionTime ? String(versionTime) : '';\n    msg.payload = displayVersion;\n    msg.history = history;\n    \n    node.status({ fill: 'green', shape: 'dot', text: displayVersion });\n    return msg;\n    \n} catch (error) {\n    node.status({ fill: 'red', shape: 'ring', text: 'ошибка получения версии' });\n    node.error('Отправить версию: ошибка при получении данных версии - ' + error.message, error);\n    return null;\n}",
